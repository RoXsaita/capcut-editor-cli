{
  "name": "capcut-editor-cli",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "author": "Suheil Abu Aittah (@RoXsaita)",
  "type": "module",
  "description": "Transactional, CapCut-native timeline editor and validator.",
  "bin": {
    "capcutctl": "./bin/capcutctl.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RoXsaita/capcut-editor-cli.git"
  },
  "bugs": {
    "url": "https://github.com/RoXsaita/capcut-editor-cli/issues"
  },
  "homepage": "https://github.com/RoXsaita/capcut-editor-cli#readme",
  "files": [
    "assets/",
    "bin/",
    "src/",
    "presets/",
    "mograph/",
    "!presets/harvest.json",
    "tools/*.py",
    "tools/caption_engine/",
    "!tools/caption_engine/__pycache__/",
    "tools/vision/ocr.swift",
    "tools/vision/face.swift",
    "tools/vision/frames.swift",
    "pyproject.toml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SETUP.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "docs/",
    ".github/AUTOMATION.md"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "check": "for f in bin/capcutctl.mjs src/*.mjs mograph/*.js mograph/scenes/*.js mograph/scenes/*.mjs examples/showreel/*.js examples/showreel/*.mjs .github/scripts/*.cjs; do node --check \"$f\" || exit 1; done"
  },
  "engines": {
    "node": ">=20"
  }
}
