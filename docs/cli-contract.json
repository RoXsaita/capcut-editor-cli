  "commands": {
    "add": {
      "group": "broll",
      "summary": "Place full-frame source media on an overlay track.",
      "example": "capcutctl add --project NAME --media screen.mp4 --at 5 --dur 3 --track broll --dry-run",
      "options": [
        "--allow-ephemeral",
        "--at",
        "--cover",
        "--derived-from",
        "--derived-offset",
        "--desc",
        "--dry-run",
        "--dur",
        "--generated",
        "--height",
        "--media",
        "--media-duration",
        "--no-localize",
        "--project",
        "--src",
        "--src-dur",
        "--track",
        "--volume",
        "--width"
      ],
      "transactional": true
    },
    "animate": {
      "group": "graphics",
      "summary": "Native CapCut intro/outro animation on a clip.",
      "example": "capcutctl animate --project NAME --segments ID --intro fade-in --dry-run",
      "options": [
        "--at",
        "--dry-run",
        "--intro",
        "--intro-dur",
        "--outro",
        "--outro-dur",
        "--plan",
        "--project",
        "--replace-existing",
        "--segments",
        "--track"
      ],
      "transactional": true
    },
    "apply": {
      "group": "safety",
      "summary": "Apply a v1 spec of operations transactionally.",
      "example": "capcutctl apply --project NAME --spec spec.json --dry-run",
      "options": [
        "--dry-run",
        "--force-running",
        "--no-backup",
        "--project",
        "--spec"
      ],
      "transactional": true
    },
    "blur-broll": {
      "group": "look",
      "summary": "Opt-in motion blur for B-roll already ramped past 8x.",
      "example": "capcutctl blur-broll --project NAME --segment ID --plan",
      "options": [
        "--dry-run",
        "--plan",
        "--project",
        "--segment"
      ],
      "transactional": true
    },
    "brands": {
      "group": "graphics",
      "summary": "Known brands, spoken aliases, and which have artwork.",
      "example": "capcutctl brands",
      "options": [],
      "transactional": false
    },
    "build": {
      "group": "build",
      "summary": "After A-roll sign-off: one edit plan → shots, layout, camera, graphics, sound, gate.",
      "example": "capcutctl build --project NAME --edit edit.json --dry-run",
      "options": [
        "--dry-run",
        "--edit",
        "--force",
        "--json",
        "--project"
      ],
      "transactional": true
    },
