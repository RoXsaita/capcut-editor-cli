{
  "contractVersion": 2,
  "cliVersion": "0.1.1",
  "dryRun": {
    "guarantee": "Every transactional edit command takes --dry-run.",
    "commands": [
      "add",
      "animate",
      "apply",
      "blur-broll",
      "build",
      "cursor",
      "denoise",
      "endcard",
      "fade",
      "finish",
      "grade",
      "keyframe",
      "layout",
      "localize",
      "logo",
      "loudness",
      "match",
      "mograph",
      "motion",
      "music",
      "new",
      "pace",
      "polish",
      "punch",
      "ramp",
      "reframe",
      "remove",
      "replace-media",
      "restore",
      "rm",
      "shift",
      "sync",
      "trim",
      "volume",
      "wrap",
      "zoom"
