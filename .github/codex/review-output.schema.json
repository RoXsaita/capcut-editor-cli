{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "side": {
            "type": "string",
            "enum": ["RIGHT", "LEFT"]
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        },
        "required": ["priority", "title", "path", "line", "side", "body"],
        "additionalProperties": false
      }
    },
    "assessment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "test_gaps": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": ["findings", "assessment", "test_gaps"],
  "additionalProperties": false
}
